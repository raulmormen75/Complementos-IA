{
  "name": "creacion-audiovisual-starter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "studio": "remotion studio src/index.ts --no-open",
    "check": "tsc --noEmit",
    "still": "remotion still src/index.ts Estudio out/fotograma.png",
    "render": "remotion render src/index.ts Estudio out/prueba.mp4",
    "render:datos": "remotion render src/index.ts DatosEnMovimiento out/datos.mp4 --codec=h264 --audio-codec=aac",
    "modelar": "node scripts/modelar.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "@remotion/cli": "4.0.537",
    "@remotion/three": "4.0.537",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.8.0",
    "remotion": "4.0.537",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/three": "0.183.1",
    "typescript": "5.9.3"
  }
}
